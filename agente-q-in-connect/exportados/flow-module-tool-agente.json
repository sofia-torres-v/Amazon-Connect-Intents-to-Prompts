              "type": "string",
              "description": "Especialidad medica. Requerido para consultar_disponibilidad y agendar_cita"
            },
            "fecha": {
              "type": "string",
              "description": "Fecha en formato YYYY-MM-DD. Requerido para consultar_disponibilidad y agendar_cita"
            },
            "hora": {
